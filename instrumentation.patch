+/// Instrumentation: snapshot of per-(role, callback) EVM call stats as dicts.
+#[pyfunction]
+fn gas_stats(py: Python<'_>) -> PyResult<Vec<PyObject>> {
+    use pyo3::types::PyDict;
+    let mut out = Vec::new();
+    for (role, cb, st) in crate::evm::strategy::gas_stats_snapshot() {
+        let d = PyDict::new_bound(py);
+        d.set_item("role", role)?; d.set_item("callback", cb)?;
+        d.set_item("calls", st.calls)?; d.set_item("ok", st.ok)?;
+        d.set_item("max_ok_gas", st.max_ok_gas)?; d.set_item("sum_ok_gas", st.sum_ok_gas as u64)?;
+        d.set_item("oog", st.oog)?; d.set_item("revert", st.revert)?;
+        d.set_item("other_halt", st.other_halt)?; d.set_item("tx_error", st.tx_error)?;
+        d.set_item("bad_return", st.bad_return)?;
+        out.push(d.into_any().unbind());
+    }
+    Ok(out)
+}
+
+/// Instrumentation: clear stats.
+#[pyfunction]
+fn gas_stats_reset() { crate::evm::strategy::gas_stats_reset(); }
+
 /// Python module definition
 #[pymodule]
 fn amm_sim_rs(m: &Bound<'_, PyModule>) -> PyResult<()> {
     m.add_function(wrap_pyfunction!(run_batch, m)?)?;
     m.add_function(wrap_pyfunction!(run_single, m)?)?;
+    m.add_function(wrap_pyfunction!(gas_stats, m)?)?;
+    m.add_function(wrap_pyfunction!(gas_stats_reset, m)?)?;
     m.add_class::<SimulationConfig>()?;
     m.add_class::<LightweightSimResult>()?;
     m.add_class::<BatchSimulationResult>()?;
