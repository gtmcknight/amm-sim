+
+impl Drop for EVMStrategy {
+    fn drop(&mut self) {
+        let mut g = GAS_STATS.lock().unwrap();
+        for (i, st) in self.stats.iter().enumerate() {
+            if st.calls > 0 {
+                g.entry((self.role.clone(), CB_NAMES[i].to_string())).or_default().merge(st);
+            }
+        }
+    }
 }
 
