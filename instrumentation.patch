+// ---- IMD gas instrumentation (audit only; does not change gas limits or economics) ----
+use std::collections::BTreeMap;
+use std::sync::Mutex;
+
+/// Per (role, callback) call statistics.
+#[derive(Clone, Default, Debug)]
+pub struct CallStats {
+    pub calls: u64,
+    pub ok: u64,
+    pub max_ok_gas: u64,
+    pub sum_ok_gas: u128,
+    pub oog: u64,
+    pub revert: u64,
+    pub other_halt: u64,
+    pub tx_error: u64,
+    pub bad_return: u64,
+}
+
+impl CallStats {
+    fn merge(&mut self, o: &CallStats) {
+        self.calls += o.calls; self.ok += o.ok; self.max_ok_gas = self.max_ok_gas.max(o.max_ok_gas);
+        self.sum_ok_gas += o.sum_ok_gas; self.oog += o.oog; self.revert += o.revert;
+        self.other_halt += o.other_halt; self.tx_error += o.tx_error; self.bad_return += o.bad_return;
+    }
+}
+
+pub static GAS_STATS: Mutex<BTreeMap<(String, String), CallStats>> = Mutex::new(BTreeMap::new());
+
+pub fn gas_stats_snapshot() -> Vec<(String, String, CallStats)> {
+    GAS_STATS.lock().unwrap().iter().map(|((r, c), v)| (r.clone(), c.clone(), v.clone())).collect()
+}
+
+pub fn gas_stats_reset() { GAS_STATS.lock().unwrap().clear(); }
+
+const CB_INIT: usize = 0;
+const CB_SWAP: usize = 1;
+const CB_NAME: usize = 2;
+const CB_NAMES: [&str; 3] = ["afterInitialize", "afterSwap", "getName"];
+// ---- end instrumentation header ----
